#!/bin/sh /etc/rc.common
START=98
STOP=10
USE_PROCD=1
SERVICE_ADMITTED=''
service_admission() {
 [ "$SERVICE_ADMITTED" = 1 ] && return 0
 # rc.common may call procd_kill even when stop_service returns failure.
 ucode /usr/lib/zapret2-home/lock.uc acquire service "$$" || exit 1
 SERVICE_ADMITTED=1
 trap 'ucode /usr/lib/zapret2-home/lock.uc release service "$$"' EXIT
}
start_service() {
 service_admission
 /usr/libexec/zapret2-home-ctl request || return 1
 if ! /usr/libexec/zapret2-home-ctl wan-ready; then
  logger -t zapret2-home 'Start requested; waiting for WAN'
  return 0
 fi
 if /usr/libexec/zapret2-home-ctl running; then /usr/libexec/zapret2-home-ctl reconcile; return; fi
 /usr/libexec/zapret2-home-ctl prepare || return 1
 procd_open_instance main
 procd_set_param command /usr/libexec/zapret2-home-worker
 if [ -f /var/run/zapret2-home/lifecycle.json ]; then
  RESTORE_TOKEN=$(ucode /usr/lib/zapret2-home/lock.uc restore-context '' "$$") || return 1
  procd_set_param env "Z2_LIFECYCLE_TOKEN=$RESTORE_TOKEN"
 fi
 procd_set_param respawn 3600 5 3
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_set_param term_timeout 5
 procd_close_instance
}
stop_service() { service_admission; /usr/libexec/zapret2-home-ctl quiesce; }
service_triggers() { procd_add_reload_trigger zapret2_home; }
restart() { stop && start; }
reload_service() { restart; }
